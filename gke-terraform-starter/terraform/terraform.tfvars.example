# Copy this file to terraform.tfvars and replace the project ID.
project_id  = "REPLACE_WITH_SANDBOX_PROJECT_ID"
region      = "me-central2"
cluster_name = "command-sandbox-gke"

# Review these CIDR ranges to ensure they do not overlap with any connected networks.
subnet_cidr             = "10.20.0.0/20"
pods_cidr               = "10.24.0.0/14"
services_cidr           = "10.28.0.0/20"
master_ipv4_cidr_block  = "172.16.0.0/28"

node_machine_type = "e2-standard-2"
node_count        = 1
min_node_count    = 1
max_node_count    = 3
